# Copy to .env and adjust. Never commit .env.

# --- API ---
NODE_ENV=development
API_PORT=4000
# Without Docker (embedded PGlite, development only):
DATABASE_URL=pglite:./.data/pglite
# With Docker (`pnpm infra:up`), use the real PostgreSQL + PostGIS server:
# DATABASE_URL=postgres://winou:winou_dev_only@localhost:5432/winou
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-min
WEB_URL=http://localhost:3000
# Email. Unset = emails (reset links, invitations) are printed in the API console.
# With Docker, Mailpit catches them at http://localhost:8025:
# SMTP_URL=smtp://localhost:1025
MAIL_FROM="Winou <no-reply@localhost>"
# Comma-separated origins allowed to call the API directly (the web app uses a same-origin proxy).
CORS_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=300
LOGIN_MAX_FAILURES=5
# Shared secret for device data (Traccar forwarding and the simulator). At least 24 characters.
# Generate one the same way as JWT_SECRET. Unset = the ingest endpoint is disabled.
INGEST_SECRET=change-me-ingest-secret-at-least-24-chars

# --- Simulator ---
SIM_API_URL=http://localhost:4000

# --- Web ---
API_INTERNAL_URL=http://localhost:4000
# The browser opens the live WebSocket directly on the API.
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000
# Map basemap: "none" (plain background) until map tiles are installed (docs/MAP_SERVICES.md).
NEXT_PUBLIC_MAP_STYLE=none

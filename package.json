{
  "name": "winou",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm -r run build",
    "build:packages": "corepack pnpm -r --filter \"./packages/*\" run build",
    "dev": "corepack pnpm build:packages && node scripts/dev.mjs",
    "dev:api": "corepack pnpm build:packages && corepack pnpm --filter @winou/api run dev",
    "test": "corepack pnpm build:packages && corepack pnpm -r run test",
    "typecheck": "corepack pnpm build:packages && corepack pnpm -r run typecheck",
    "db:migrate": "corepack pnpm --filter @winou/api run db:migrate",
    "db:seed": "corepack pnpm --filter @winou/api run db:seed",
    "db:seed:reset": "corepack pnpm --filter @winou/api run db:seed -- --reset",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "sim": "corepack pnpm --filter @winou/simulator run start",
    "db:server": "corepack pnpm --filter @winou/api run db:server",
    "db:check": "corepack pnpm --filter @winou/api run db:check",
    "basemap": "node scripts/fetch-basemap.mjs",
    "routes:home": "node scripts/build-home-routes.mjs",
    "routes:sim": "node scripts/build-sim-routes.mjs",
    "preview": "corepack pnpm build && node scripts/dev.mjs --prod",
    "mobile": "corepack pnpm --filter @winou/mobile run start",
    "mobile:web": "corepack pnpm --filter @winou/mobile run web"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.5",
    "pbf": "4.0.2",
    "pmtiles": "4.5.0",
    "typescript": "~5.7.2"
  }
}
